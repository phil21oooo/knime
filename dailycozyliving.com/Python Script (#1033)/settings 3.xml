        <entry key="script" type="xstring" value="import knime.scripting.io as knio%%00010import pandas as pd%%00010import re%%00010%%00010# Eingabetabelle aus KNIME%%00010df = knio.input_tables[0].to_pandas()%%00010%%00010# Flow-Variable holen (Standard = 400)%%00010max_chars = int(knio.flow_variables.get(&quot;max_chars&quot;, 400))%%00010%%00010def insert_paragraphs(text, max_chars):%%00010    &quot;&quot;&quot;%%00010    Teilt Text in Absätze nach max_chars Zeichen,%%00010    respektiert vorhandene Absätze (doppeltes \n\n) und H2-Überschriften.%%00010    &quot;&quot;&quot;%%00010    # Erst in Blöcke aufteilen (Absätze oder H2)%%00010    blocks = re.split(r'(\n\n|## .*?\n)', text.strip())%%00010%%00010    processed_blocks = []%%00010    for block in blocks:%%00010        if not block.strip():%%00010            continue%%00010%%00010        # Wenn es eine Überschrift ist oder schon Absatz → direkt übernehmen%%00010        if block.startswith(&quot;##&quot;) or block.strip() == &quot;\n\n&quot;:%%00010            processed_blocks.append(block.strip())%%00010            continue%%00010%%00010        # Innerhalb normaler Textblöcke in Sätze splitten%%00010        sentences = re.split(r'(?&lt;=[.!?])\s+', block.strip())%%00010        current = &quot;&quot;%%00010        paragraphs = []%%00010%%00010        for sentence in sentences:%%00010            if current and len(current) + len(sentence) + 1 &gt; max_chars:%%00010                paragraphs.append(current.strip())%%00010                current = sentence%%00010            else:%%00010                current += &quot; &quot; + sentence if current else sentence%%00010%%00010        if current:%%00010            paragraphs.append(current.strip())%%00010%%00010        # Paragraphs mit doppeltem Zeilenumbruch verbinden%%00010        processed_blocks.append(&quot;\n\n&quot;.join(paragraphs))%%00010%%00010    return &quot;\n\n&quot;.join(processed_blocks)%%00010%%00010# Ausgangsspalte &quot;article&quot; überschreiben%%00010df[&quot;article&quot;] = df[&quot;article&quot;].apply(lambda x: insert_paragraphs(str(x), max_chars))%%00010%%00010# Ergebnis zurückgeben%%00010knio.output_tables[0] = knio.Table.from_pandas(df)%%00010"/>
